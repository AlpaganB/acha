{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://acha-api-production.up.railway.app/api/v1/:path*"
    },
    {
      "source": "/(assessment|assessments|measurements|guides|mission|research|crew|scenarios)/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/v1/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
